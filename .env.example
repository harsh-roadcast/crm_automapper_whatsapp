APP_NAME="Roadcast CRM Automapper WhatsApp"
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_automapper
REDIS_URL=redis://localhost:6379/0
INACTIVITY_TIMEOUT_MINUTES=10

WHATSAPP_VERIFY_TOKEN=replace-with-meta-verify-token
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_APP_SECRET=replace-with-app-secret
WHATSAPP_GRAPH_API_VERSION=v25.0

ZOHO_CLIENT_ID=replace-with-zoho-client-id
ZOHO_CLIENT_SECRET=replace-with-zoho-client-secret
ZOHO_REFRESH_TOKEN=replace-with-zoho-refresh-token
ZOHO_BASE_URL=https://www.zohoapis.in
ZOHO_LEADS_MODULE=Leads